{
  "version": 6,
  "configurePresets": [
    {
      "name": "Ninja-Debug",
      "displayName": "Ninja Config(Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "HTTP_PROXY": "http://127.0.0.1:51081",
        "HTTPS_PROXY": "http://127.0.0.1:51081",
        "ALL_PROXY": "socks5://127.0.0.1:51081"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "Ninja-Release",
      "displayName": "Ninja Config(Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "HTTP_PROXY": "http://127.0.0.1:51081",
        "HTTPS_PROXY": "http://127.0.0.1:51081",
        "ALL_PROXY": "socks5://127.0.0.1:51081"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Build Debug",
      "configurePreset": "Ninja-Debug",
      "targets": [
        "all"
      ],
      "configuration": "Debug"
    },
    {
      "name": "Build Release",
      "configurePreset": "Ninja-Release",
      "targets": [
        "all"
      ],
      "configuration": "Release"
    }
  ]
}
